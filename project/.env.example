# ─────────────────────────────────────────────────────────────────────
#  سرزمین عسل — Environment Configuration (Template)
#  Copy this file to .env and fill in your values.
#  In production, setup.sh creates .env automatically — you don't need this.
# ─────────────────────────────────────────────────────────────────────

# SQLite database path. Default points to the project's db/ folder.
DATABASE_URL=file:/opt/sarzemine-asal/db/custom.db

# ── Telegram Bot ──────────────────────────────────────────────────────
# Your bot token from @BotFather (replace with your real token)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Numeric Telegram ID of the admin (send /start to @userinfobot to find yours)
TELEGRAM_ADMIN_ID=YOUR_ADMIN_ID_HERE

# HTTP port for bot's notification receiver (internal, not exposed publicly)
BOT_PORT=3003

# ── Site ↔ Bot communication ─────────────────────────────────────────
# The site calls this URL to notify the bot of new orders / payments.
# Keep as localhost since both run on the same server.
BOT_SERVICE_URL=http://localhost:3003

# ── Site ─────────────────────────────────────────────────────────────
# Port the Next.js site listens on (internal; Caddy proxies to this)
SITE_PORT=3000
NODE_ENV=production

# ── Admin Panel (optional — for first install only) ───────────────────
# These are used by setup.sh when seeding the default admin user.
# After install, change admin password via the admin panel itself.
# Default credentials if not set: username=admin, password=admin12345
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin12345

# Secret used to sign admin session cookies (auto-generated if not set,
# but for production you should set a long random string here)
# ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
