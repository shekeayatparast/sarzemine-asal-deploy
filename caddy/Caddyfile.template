# ─────────────────────────────────────────────────────────────────────
#  Caddyfile template for سرزمین عسل
#  Caddy automatically obtains and renews Let's Encrypt SSL certificates.
#  The {domain} placeholder is replaced by setup.sh with your real domain.
# ─────────────────────────────────────────────────────────────────────

{$DOMAIN} {
	# Reverse proxy all traffic to the Next.js site (port 3000)
	reverse_proxy localhost:3000

	# Compression
	encode gzip zstd

	# Security headers
	header {
		# X-Frame-Options prevents clickjacking
		X-Frame-Options "SAMEORIGIN"
		# X-Content-Type-Options prevents MIME sniffing
		X-Content-Type-Options "nosniff"
		# Referrer-Policy
		Referrer-Policy "strict-origin-when-cross-origin"
		# Remove Caddy version header for security
		-Server
	}

	# Static asset caching (Next.js assets)
	@static {
		path *.js *.css *.svg *.png *.jpg *.jpeg *.gif *.ico *.woff *.woff2
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Access & error logs
	log {
		output file /var/log/caddy/sarzemine-asal-access.log {
			roll_size 10mb
			roll_keep 5
		}
		format common
	}
}
